{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://REPLACE-ME.example.com/aibm/schemas/blueprint-metadata.schema.json",
  "title": "Blueprint Metadata",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "version", "artifact_type", "intent"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "artifact_type": { "type": "string", "minLength": 1 },
    "intent": {
      "type": "object",
      "required": ["audience", "objective"],
      "properties": {
        "audience": { "type": "string" },
        "objective": { "type": "string" }
      }
    }
  }
}
