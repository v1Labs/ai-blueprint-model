{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://REPLACE-ME.example.com/aibm/schemas/asset/schema.json",
  "title": "AIBM Asset Blueprint Structure",
  "description": "Reusable richer file and section shape for artifact-generation blueprints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["extends", "required_files", "required_directories", "markdown_sections"],
  "properties": {
    "extends": {
      "type": "string",
      "const": "basic"
    },
    "required_files": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "README.md",
          "inputs.md",
          "outputs.md",
          "constraints.md",
          "components.md",
          "evaluations.md"
        ]
      },
      "uniqueItems": true,
      "minItems": 6
    },
    "required_directories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["examples/"]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "markdown_sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["README.md"],
      "properties": {
        "README.md": {
          "type": "array",
          "description": "Allowed top-level sections in README.md",
          "items": {
            "type": "string",
            "enum": [
              "Purpose",
              "Inputs",
              "Outputs",
              "Constraints",
              "Components",
              "Examples",
              "Evaluations",
              "QA Guidance"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    }
  }
}
